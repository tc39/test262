/*---
desc: ASI separates escaped accessor instance and static fields from following fields
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public]
---*/

//- elements
\u0061ccessor
a = 1;
static \u0061ccessor
b = 2;
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["accessor", "a", "b"]);
assert.compareArray(Object.keys(C), ["accessor"]);
assert.compareArray([c.a, c.b], [1, 2]);
