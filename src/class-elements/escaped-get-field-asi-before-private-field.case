/*---
desc: ASI separates escaped get instance and static fields from following private fields
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public, class-fields-private]
---*/

//- elements
\u{67}et
#a = 1;
static \u{67}et
#b = 2;
check() { return [this.#a, this.#b]; }
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["get"]);
assert.compareArray(Object.keys(C), ["get"]);
assert.compareArray(c.check(), [1, 2]);
