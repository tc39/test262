/*---
desc: ASI separates escaped static instance and static fields from following methods
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public]
---*/

//- elements
s\u0074atic
a() { return 1; }
static s\u0074atic
b() { return 2; }
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["static"]);
assert.compareArray(Object.keys(C), ["static"]);
assert.compareArray(Object.getOwnPropertyNames(C.prototype), ["constructor", "a", "b"]);
assert.compareArray([c.a(), c.b()], [1, 2]);
