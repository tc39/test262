/*---
desc: ASI separates escaped async instance and static fields from following fields
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public]
---*/

//- elements
\u0061sync
a = 1;
static \u0061sync
b = 2;
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["async", "a", "b"]);
assert.compareArray(Object.keys(C), ["async"]);
assert.compareArray([c.a, c.b], [1, 2]);
