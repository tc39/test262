/*---
desc: ASI separates escaped accessor instance and static fields from following methods
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public]
---*/

//- elements
acc\u0065ssor
a() { return 1; }
static acc\u0065ssor
b() { return 2; }
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["accessor"]);
assert.compareArray(Object.keys(C), ["accessor"]);
assert.compareArray(Object.getOwnPropertyNames(C.prototype), ["constructor", "a", "b"]);
assert.compareArray([c.a(), c.b()], [1, 2]);
