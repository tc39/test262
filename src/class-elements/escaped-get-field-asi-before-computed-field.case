/*---
desc: ASI separates escaped get instance and static fields from following computed fields
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public, computed-property-names]
---*/

//- elements
ge\u{74}
["a"] = 1;
static ge\u{74}
["b"] = 2;
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["get", "a", "b"]);
assert.compareArray(Object.keys(C), ["get"]);
assert.compareArray([c.a, c.b], [1, 2]);
