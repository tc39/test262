/*---
desc: ASI separates escaped async instance and static fields from following computed fields
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public, computed-property-names]
---*/

//- elements
asyn\u{63}
["a"] = 1;
static asyn\u{63}
["b"] = 2;
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["async", "a", "b"]);
assert.compareArray(Object.keys(C), ["async"]);
assert.compareArray([c.a, c.b], [1, 2]);
