/*---
desc: ASI separates escaped set instance and static fields from following fields separated by multiline comments
template: default
includes: [compareArray.js]
features: [class-fields-public, class-static-fields-public]
---*/

//- elements
s\u0065t /*
*/ a = 1;
static s\u0065t /*
*/ b = 2;
//- assertions
var c = new C();
assert.compareArray(Object.keys(c), ["set", "a", "b"]);
assert.compareArray(Object.keys(C), ["set"]);
assert.compareArray([c.a, c.b], [1, 2]);
