/*---
desc: >
  Object rest element cannot be followed by a comma in ObjectAssignmentPattern.
template: syntax
esid: prod-ObjectAssignmentPattern
negative:
  phase: parse
  type: SyntaxError
features: [object-rest]
---*/

//- setup
$DONOTEVALUATE();
var rest;
//- elems
{...rest,}
//- vals
{}

